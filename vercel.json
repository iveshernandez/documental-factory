{
  "rewrites": [
    {
      "source": "/ort/:path*",
      "destination": "https://cdnjs.cloudflare.com/ajax/libs/onnxruntime-web/1.18.0/:path*"
    },
    {
      "source": "/piper/:path*",
      "destination": "https://cdn.jsdelivr.net/npm/@diffusionstudio/piper-wasm@1.0.0/build/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/ort/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/piper/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}